# ──────────────────────────────────────────────────
# Arandu API — Variaveis de Ambiente
# ──────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ──────────────────────────────────────────────────

# Ambiente da aplicacao
NODE_ENV=development

# ── Servidor ──────────────────────────────────
PORT=3000

# ── Banco de Dados ──────────────────────────────
# DESNVOLVIMENTO LOCAL (SQLite):
DATABASE_URL=file:./dev.db
# PRODUCAO/HOMOLOGACAO (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Autenticacao JWT ────────────────────────────
JWT_SECRET=TroqueEstaChavePorUmValorSeguroEmProducao2026!
REFRESH_SECRET=TroqueEstaChaveRefreshPorUmValorSeguroEmProducao2026!

# ── Supabase API (apenas em producao/homologacao) ─
# Pegue no painel do Supabase > Settings > API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGci...TROQUE_AQUI
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...TROQUE_AQUI

# ── Frontend (CORS + Links de e-mail) ───────────
FRONTEND_URL=http://localhost:5173
# Em producao: FRONTEND_URL=https://arandunotes.onrender.com
