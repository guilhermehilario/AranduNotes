# ──────────────────────────────────────────────────
# Arandu API — Variaveis de Ambiente
# ──────────────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# ──────────────────────────────────────────────────

# Ambiente da aplicacao
NODE_ENV=development

# ── Servidor ──────────────────────────────────
PORT=3000

# ── Banco de Dados ──────────────────────────────
# DESNVOLVIMENTO LOCAL (SQLite):
DATABASE_URL=file:./dev.db
# PRODUCAO/HOMOLOGACAO (Supabase PostgreSQL):
#  - Conexao direta (porta 5432): usa a CA privada da Supabase via
#    PGSSLROOTCERT. Baixe o certificado do painel (Projeto > Connect > SSL).
#    Ex.:
#    DATABASE_URL=postgresql://postgres.CHANGE_ME:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres
#    PGSSLROOTCERT=/caminho/para/supabase-ca.pem
#  - Ou via pooler transactional (porta 6543, CA publica):
#    DATABASE_URL=postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# PGSSLROOTCERT=

# ── Autenticacao JWT ────────────────────────────
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY
REFRESH_SECRET=CHANGE_ME_BEFORE_DEPLOY

# ── Supabase API (apenas em producao/homologacao) ─
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_BEFORE_DEPLOY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_BEFORE_DEPLOY

# ── Frontend (CORS + Links de e-mail) ───────────
FRONTEND_URL=http://localhost:5173
# Em producao: FRONTEND_URL=https://arandunotes.onrender.com

# ── SMTP (opcional — sem isso, e-mails sao simulados no console) ──
SMTP_HOST=CHANGE_ME_BEFORE_DEPLOY
EMAIL_USER=CHANGE_ME_BEFORE_DEPLOY
EMAIL_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
