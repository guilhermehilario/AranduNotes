generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Usuários da plataforma
model User {
  id                        String    @id @default(uuid())
  name                      String
  email                     String    @unique
  password                  String
  avatarUrl                 String
  emailVerified             Boolean   @default(false)
  verificationToken         String?
  verificationTokenExpires  DateTime?
  resetPasswordToken        String?
  resetPasswordTokenExpires DateTime?
  acceptedTerms             Boolean   @default(false)
  acceptedTermsAt           DateTime?
  theme                     String    @default("system") // "light" | "dark" | "system"
  deletedAt                 DateTime? // Soft-delete: nulo = ativo, preenchido = conta excluída
  // 🔐 MÉDIO-17: Rate limiting por conta (brute force protection)
  failedLoginAttempts       Int       @default(0)
  lockedUntil               DateTime?
  // 🙋 Presença — status manual + heartbeats para derivar "online"
  status                    String    @default("available") // "available" | "busy" | "invisible" | "offline"
  lastActiveAt              DateTime? // Atualizado por heartbeat (deriva "online")
  // 🤝 Código único para adicionar amigos (alternativa ao e-mail)
  friendCode                String?   @unique
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  notebooks        Notebook[]
  studySessions    StudySession[]
  reviewLogs       ReviewLog[]
  tags             Tag[]
  bookmarks        Bookmark[]
  editHistory      EditHistory[]
  todos            Todo[]
  events           Event[]
  goals            Goal[]
  pomodoroSessions PomodoroSession[]
  questions        Question[]
  mockExams        MockExam[]
  mockExamAttempts MockExamAttempt[]
  refreshTokens    RefreshToken[]
  sharesOwned      Share[]              @relation("ShareOwner")
  sharesReceived   Share[]              @relation("ShareRecipient")

  friendLinks    Friend[]        @relation("FriendOwner")
  friendOfLinks  Friend[]        @relation("FriendTarget")
  friendRequestsSent    FriendRequest[] @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestRecipient")
  sentMessages   DirectMessage[]        @relation("MessageSender")
  receivedMessages DirectMessage[]      @relation("MessageRecipient")
}

/// Relação de amizade (duas linhas direcionais: owner -> friend).
model Friend {
  id       String   @id @default(uuid())
  ownerId  String
  friendId String
  createdAt DateTime @default(now())

  owner  User @relation("FriendOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([friendId])
}

/// Solicitação de amizade (pendente / aceita / recusada / cancelada).
model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  status      String   @default("pending") // "pending" | "accepted" | "declined" | "cancelled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender    User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
}

/// Mensagem direta entre amigos (texto ou link para conteúdo compartilhado).
model DirectMessage {
  id             String   @id @default(uuid())
  senderId       String
  recipientId    String
  contentType    String   @default("text") // "text" | "content_link"
  content        String
  contentRef     String? // JSON: { resourceType, resourceId, title } p/ content_link
  readAt         DateTime?
  createdAt      DateTime @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// Compartilhamentos de conteúdo entre usuários (item pode ser editado pelo
/// destinatário). O dono do recurso é sempre o criador; compartilhar concede
/// acesso a usuários específicos; deixar público gera um link sem login.
/// Para cadernos, o scope (via NotebookShareScope) controla quais folhas
/// o destinatário pode ver/editar — sem scope = acesso total.
///
/// Capacidades (canEditContent / canCreateLeaves / canUploadFiles):
/// quando permission = "editor", o dono pode granularizar o que o editor
/// pode fazer. Se permission = "viewer", NENHUMA capacidade é concedida
/// (o destinatário apenas visualiza) e todas ficam false.
model Share {
  id               String   @id @default(uuid())
  resourceType     String // "notebook" | "leaf" | "question" | "flashcard" | "mockExam"
  resourceId       String
  ownerId          String   // Quem compartilha (dono do recurso)
  sharedWithUserId String
  permission       String   @default("viewer") // "viewer" (só leitura) | "editor" (pode editar)
  // 🔧 Capacidades de edição (só têm efeito quando permission = "editor")
  canEditContent   Boolean  @default(false) // Editar textos das folhas
  canCreateLeaves  Boolean  @default(false) // Criar folhas e sub-folhas
  canUploadFiles   Boolean  @default(false) // Enviar arquivos (imagem/texto/áudio)
  createdAt        DateTime @default(now())

  owner          User    @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWithUser User    @relation("ShareRecipient", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
  scope          NotebookShareScope[]

  @@unique([resourceType, resourceId, sharedWithUserId])
  @@index([sharedWithUserId])
  @@index([resourceType, resourceId])
}

/// Escopo de acesso para compartilhamentos de caderno — lista de folhas que
/// o destinatário pode ver/editar. Se vazio (= sem registros para o Share),
/// o destinatário tem acesso a todas as folhas do caderno.
model NotebookShareScope {
  id       String @id @default(uuid())
  shareId  String
  leafId   String
  createdAt DateTime @default(now())

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)
  leaf  Leaf  @relation(fields: [leafId], references: [id], onDelete: Cascade)

  @@unique([shareId, leafId])
  @@index([shareId])
  @@index([leafId])
}

/// Refresh tokens rotacionáveis (família de tokens por sessão)
/// 🔐 SEC: cada refresh token é emitido pelo servidor e registrado aqui
/// (apenas o hash SHA-256, nunca o token em texto puro). A cada rotação o
/// token antigo é revogado; o reuso de um token já revogado encerra a família.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique // SHA-256 do JWT — nunca armazenar o token em texto puro
  expiresAt         DateTime
  revokedAt         DateTime? // Preenchido = token revogado (logout, rotação ou reuso detectado)
  replacedByTokenId String? // Token que substituiu este na rotação (rastreamento da família)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Cadernos de anotação (disciplinas/matérias)
model Notebook {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  color       String
  isPublic    Boolean   @default(false) // Link público (acesso sem login)
  publicToken String?   @unique // Token do link público
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft-delete: nulo = ativo, preenchido = na lixeira

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves        Leaf[]
  flashcards    Flashcard[]
  reviewLogs    ReviewLog[]
  studySessions StudySession[]
  bookmarks     Bookmark[]
  editHistory   EditHistory[]
  questions     Question[]
  mockExams     MockExam[]
}

/// Folhas de anotação (aulas individuais dentro de um caderno)
model Leaf {
  id         String    @id @default(uuid())
  notebookId String
  title      String
  content    String    @default("")
  rawText    String    @default("")
  summary    String?
  parentId   String? // Para sub-folhas (árvore hierárquica)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  position   Int       @default(0) // Ordenação manual (drag & drop)
  isPublic   Boolean   @default(false) // Link público (acesso sem login)
  publicToken String?  @unique // Token do link público
  archivedAt DateTime? // Arquivado: nulo = ativo, preenchido = arquivado
  deletedAt  DateTime? // Soft-delete: nulo = ativo, preenchido = na lixeira

  notebook    Notebook        @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  flashcards  Flashcard[]
  parent      Leaf?           @relation("LeafChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Leaf[]          @relation("LeafChildren")
  tags        LeafTag[]
  bookmarks   Bookmark[]
  editHistory EditHistory[]
  questions   Question[]
  shareScopes NotebookShareScope[]
  attachments LeafAttachment[]
}

/// Arquivos anexados a uma folha (imagem, texto, áudio — até 5MB).
/// O conteúdo é armazenado como BLOB/bytea no banco; a permissão de upload
/// é controlada pela capacidade canUploadFiles do compartilhamento do caderno.
model LeafAttachment {
  id         String   @id @default(uuid())
  leafId     String
  uploadedBy String
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  leaf Leaf @relation(fields: [leafId], references: [id], onDelete: Cascade)

  @@index([leafId])
}

/// Histórico de edições de folhas e cadernos
model EditHistory {
  id         String   @id @default(uuid())
  userId     String
  leafId     String?
  notebookId String?
  action     String // "created", "updated", "deleted", "restored"
  fieldName  String? // "title", "content", "summary", etc.
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaf     Leaf?     @relation(fields: [leafId], references: [id], onDelete: Cascade)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)
}

/// Tags para classificação de folhas
model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#aa3bff")
  createdAt DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves LeafTag[]

  @@unique([userId, name])
}

/// Relação N:N entre Leaf e Tag
model LeafTag {
  leafId String
  tagId  String

  leaf Leaf @relation(fields: [leafId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leafId, tagId])
}

/// Marcadores de páginas (bookmarks)
model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  leafId     String?
  notebookId String?
  title      String
  path       String
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaf     Leaf?     @relation(fields: [leafId], references: [id], onDelete: SetNull)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
}

/// Questões de estudo (múltipla escolha, verdadeiro/falso, resposta curta)
model Question {
  id            String   @id @default(uuid())
  leafId        String?
  notebookId    String
  userId        String
  question      String
  options       String   @default("[]") // JSON array de opções
  correctAnswer String
  explanation   String?
  questionType  String   @default("multiple_choice") // "multiple_choice" | "true_false" | "short_answer" | "dissertative"
  theme         String?
  isPublic      Boolean  @default(false) // Link público (acesso sem login)
  publicToken   String?  @unique // Token do link público
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notebook      Notebook           @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  leaf          Leaf?              @relation(fields: [leafId], references: [id], onDelete: SetNull)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  examQuestions MockExamQuestion[]
}

/// Simulados (agrupamentos de questões)
model MockExam {
  id          String   @id @default(uuid())
  userId      String
  notebookId  String?
  title       String
  description String?
  timeLimit   Int? // em minutos
  isPublic    Boolean   @default(false) // Link público (acesso sem login)
  publicToken String?   @unique // Token do link público
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook  Notebook?          @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  questions MockExamQuestion[]
  attempts  MockExamAttempt[]
}

/// Relação N:N entre MockExam e Question
model MockExamQuestion {
  id         String @id @default(uuid())
  examId     String
  questionId String
  order      Int    @default(0)

  exam     MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
}

/// Tentativas de responder a um simulado (submissão corrigida)
model MockExamAttempt {
  id             String   @id @default(uuid())
  examId         String
  userId         String
  answers        String   @default("{}") // JSON: { questionId: resposta }
  selfGrades     String   @default("{}") // JSON: { questionId: true|false } (dissertativas)
  correctCount   Int      @default(0)
  totalQuestions Int      @default(0)
  score          Int      @default(0) // percentual 0-100
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  exam MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId, createdAt])
  @@index([userId, createdAt])
}

/// Flashcards gerados por IA com parâmetros do algoritmo SM-2
model Flashcard {
  id             String    @id @default(uuid())
  leafId         String
  notebookId     String
  front          String
  back           String
  repetitions    Int       @default(0)
  interval       Int       @default(0)
  easeFactor     Float     @default(2.5)
  nextReviewDate DateTime
  isPublic       Boolean   @default(false) // Link público (acesso sem login)
  publicToken    String?   @unique // Token do link público
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? // Soft-delete: nulo = ativo, preenchido = na lixeira

  leaf       Leaf        @relation(fields: [leafId], references: [id], onDelete: Cascade)
  notebook   Notebook    @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]
}

/// Tarefas da lista de afazeres (todo-list)
/// Eventos de agenda e cronograma (planejamento)
model Event {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  time        String? // "HH:mm"
  type        String   @default("agenda") // "agenda" | "cronograma"
  status      String   @default("pending") // "pending" | "completed" | "cancelled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Metas de estudo (planejamento)
model Goal {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Sessões de Pomodoro
model PomodoroSession {
  id        String    @id @default(uuid())
  userId    String
  taskName  String?
  duration  Int       @default(25)
  completed Boolean   @default(false)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String   @id @default(uuid())
  userId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Histórico de revisões de flashcards (cada review vira um registro)
model ReviewLog {
  id         String   @id @default(uuid())
  flashcardId String
  notebookId String
  userId     String
  score      Int
  easeFactor Float    @default(2.5)
  interval   Int      @default(0)
  createdAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  notebook  Notebook  @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([notebookId, createdAt])
}

/// Sessões de estudo persistentes (progresso do usuário)
model StudySession {
  id               String   @id @default(uuid())
  notebookId       String
  userId           String
  currentIndex     Int      @default(0)
  reviewedCount    Int      @default(0)
  showAnswer       Boolean  @default(false)
  sessionActive    Boolean  @default(false)
  flashcards       String   @default("[]")
  completedCardIds String   @default("[]")
  scores           String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notebookId, userId])
}
